# Banco onde o robô grava (local: docker compose; produção: Supabase)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/coletor
# Banco usado só pelos testes (é apagado e recriado a cada teste)
DATABASE_URL_TESTE=postgresql://postgres:postgres@localhost:5432/coletor_teste
# Webhook de um canal do Discord para alertas (vazio = alertas só no log)
DISCORD_WEBHOOK_URL=
# Execução com menos de LIMIAR_ANOMALIA x média recente vira "parcial"
LIMIAR_ANOMALIA=0.5
JANELA_ANOMALIA=7
# Origens liberadas no CORS da API (painel React)
CORS_ORIGENS=http://localhost:5173
